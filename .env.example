# AlgoTrade Sentinel
# Copy this file to `.env` for local Docker or local app runs.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_NAME=AlgoTrade Sentinel
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Backend security and networking
# -----------------------------------------------------------------------------
# Public frontend origin used by FastAPI CORS and docs links.
FRONTEND_URL=http://localhost:3000
# JSON array or comma-separated list of allowed origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Replace this before using any shared environment.
SECRET_KEY=change-me-in-production
RATE_LIMIT_DEFAULT=120/minute
ENABLE_REQUEST_LOGGING=true

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local default:
DATABASE_URL=postgresql://algotrade:algotrade@localhost:5432/algotrade
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
POSTGRES_DB=algotrade
POSTGRES_USER=algotrade
POSTGRES_PASSWORD=algotrade

# -----------------------------------------------------------------------------
# MLOps and scheduling
# -----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_STATUS_TIMEOUT_SECONDS=3
PREFECT_API_URL=http://localhost:4200/api
ENABLE_APSCHEDULER=false
INGEST_CRON=15 22 * * 1-5
FEATURE_CRON=30 22 * * 1-5
INFERENCE_CRON=45 22 * * 1-5
MONITORING_CRON=0 23 * * 1-5

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Browser-visible backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side route handlers can use the container-internal backend URL.
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AlgoTrade Sentinel
